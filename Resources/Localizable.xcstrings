      }
    },
    "One click on the menu bar icon applies the app's last layout — no chord needed. Right-click still opens the menu." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "메뉴 막대 아이콘을 한 번 클릭하면 앱의 마지막 레이아웃을 적용합니다. 오른쪽 클릭은 메뉴를 엽니다." } }
      }
    },
    "One-keystroke layouts" : {
      "extractionState" : "manual",
