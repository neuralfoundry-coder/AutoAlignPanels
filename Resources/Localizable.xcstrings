      }
    },
    "Other feedback" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기타 피드백" } }
      }
    },
    "Play sound cue per layout" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "레이아웃별 소리 신호 재생" } }
      }
    },
    "Plays a distinct system sound for each layout, and different sounds for partial or failed alignments." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "레이아웃마다 다른 시스템 사운드를 재생하고, 부분 성공이나 실패 시 다른 소리를 냅니다." } }
      }
    },
    "Predictable, repeatable window arrangements that replace drag-and-resize." : {
      "extractionState" : "manual",
      "localizations" : {
