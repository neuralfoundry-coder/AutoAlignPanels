    "Accessibility permission is required. Enable AutoAlignPanels in System Settings, Privacy and Security, Accessibility." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "손쉬운 사용 권한이 필요합니다. 시스템 설정 › 개인정보 보호 및 보안 › 손쉬운 사용에서 AutoAlignPanels를 켜 주세요." } }
