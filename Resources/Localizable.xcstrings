      "extractionState" : "manual",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "AutoAlignPanels는 메뉴 막대에 있습니다 — 그리드 아이콘을 찾아보세요." } }
      }
    },
    "AutoAlignPanels, keyboard-driven window accessibility tool" : {
      "extractionState" : "manual",
      "localizations" : {
