    },
    "An accessibility tool for arranging, announcing, and focusing the front app's windows — entirely from the keyboard." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 앱의 창을 정렬하고, 안내하고, 포커스하는 손쉬운 사용 도구 — 모두 키보드만으로." } }
      }
    },
    "An accessibility tool that arranges, announces, and focuses the front app's windows from the keyboard — for users with vision, motor, or cognitive needs." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시각·운동·인지 접근성이 필요한 사용자를 위해, 키보드만으로 현재 앱의 창을 정렬하고 안내하고 포커스하는 손쉬운 사용 도구입니다." } }
      }
    },
    "Announce window position" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "창 위치 안내" } }
      }
    },
    "Arranges windows of the front app into a grid." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 앱의 창을 그리드로 정렬합니다." } }
      }
    },
    "Arranges windows of the frontmost app into a grid." : {
      "extractionState" : "manual",
      "localizations" : {
